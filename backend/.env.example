SERVER_PORT=8080
SPRING_SQL_INIT_MODE=never

MYSQL_URL=jdbc:mysql://localhost:3306/devtalk?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_USERNAME=devtalk_user
MYSQL_PASSWORD=change-me

LLM_MODE=mock
LLM_DEFAULT_TEMPERATURE=0.2
LLM_DEFAULT_MAX_TOKENS=8192
LLM_CONTEXT_TAIL_MAX_MESSAGES=12
LLM_CONTEXT_TAIL_MAX_CHARS=6000
LLM_CONTEXT_SUMMARY_PROMPT_MAX_CHARS=1000
LLM_CONTEXT_SUMMARY_HARD_MAX_CHARS=1200
LLM_CONTEXT_SUMMARY_KEEP_TAIL_MESSAGES=12
LLM_CONTINUE_MAX_ROUNDS=2
LLM_CONTINUE_ANCHOR_CHARS=200
LLM_SSE_EMITTER_TIMEOUT_MS=180000
LLM_STREAM_EXECUTOR_CORE_POOL_SIZE=4
LLM_STREAM_EXECUTOR_MAX_POOL_SIZE=8
LLM_STREAM_EXECUTOR_QUEUE_CAPACITY=100

LLM_GEMINI_API_KEY=your-gemini-api-key-here
LLM_GEMINI_MODEL=gemini-2.5-flash
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
LLM_GEMINI_CONNECT_TIMEOUT_MS=3000
LLM_GEMINI_READ_TIMEOUT_MS=15000
LLM_GEMINI_STREAM_RESPONSE_TIMEOUT_MS=60000

CORS_ALLOWED_ORIGINS=http://localhost:5174
