LLM_GEMINI_CONNECT_TIMEOUT_MS=3000
LLM_GEMINI_READ_TIMEOUT_MS=15000
LLM_GEMINI_STREAM_RESPONSE_TIMEOUT_MS=60000

CORS_ALLOWED_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=/api/devtalk

