COMPOSE_PROJECT_NAME=devtalk

DEVTALK_FRONTEND_HOST_PORT=8080
DEVTALK_BACKEND_DEBUG_PORT=18080

MYSQL_DATABASE=devtalk
MYSQL_USER=devtalk_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

SERVER_PORT=8080
SPRING_SQL_INIT_MODE=never

MYSQL_URL=jdbc:mysql://devtalk-db:3306/devtalk?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MYSQL_USERNAME=devtalk_app
MYSQL_PASSWORD=change-me

LLM_MODE=mock
LLM_GEMINI_API_KEY=change-me
